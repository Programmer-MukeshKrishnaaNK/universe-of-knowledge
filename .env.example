# ─── AI guide ───────────────────────────────────────────────────────────
# Keys live server-side only. Nothing here is exposed to the browser.
#
# AI_PROVIDER: openrouter | openai-compatible | offline
#   offline  → no network calls; the guide answers from the structured graph.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Any OpenRouter model id. ":free" variants cost nothing but change often —
# check https://openrouter.ai/models?max_price=0 and swap freely.
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# For AI_PROVIDER=openai-compatible (OpenAI, Groq, Together, local Ollama…)
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
# AI_MODEL=llama3.1

# Production server port (npm start)
PORT=8787
